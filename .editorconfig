# EditorConfig configuration for HeatSense
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Python and C/C++ indentation
[*.{py,cpp,hpp,c,h}]
indent_style = space
indent_size = 4

# Web, configs, and documentation indentation
[*.{ts,tsx,js,jsx,json,yaml,yml,md,sql,toml}]
indent_style = space
indent_size = 2

# PowerShell scripts
[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4

# Makefiles
[Makefile]
indent_style = tab
